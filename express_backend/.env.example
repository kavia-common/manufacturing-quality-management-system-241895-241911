# Express backend configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# MongoDB (from mongo_database container)
# Required:
# Example from db_connection.txt:
#   mongosh mongodb://appuser:dbuser123@localhost:5000/myapp?authSource=admin
MONGODB_URL=mongodb://appuser:dbuser123@localhost:5000/myapp?authSource=admin
MONGODB_DB=myapp

# Auth / RBAC
# Required:
JWT_SECRET=change-me-in-prod
# Optional:
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Uploads
# Optional:
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=10485760
